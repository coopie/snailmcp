{
  "name": "snailmcp",
  "version": "0.1.0",
  "description": "Call tools over email. A Cloudflare Email Worker that lets an email-only AI agent use tools.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "try": "node scripts/send-test.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mimetext": "^3.0.28",
    "postal-mime": "^4.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coopie/snailmcp.git"
  }
}
